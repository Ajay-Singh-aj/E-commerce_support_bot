# ShopDesk AI configuration. Copy to .env and fill in ANY ONE key (or run Ollama locally).

# Which chat model to use: auto | openai | groq | gemini | ollama
# auto = the first available, in this order: OPENAI_API_KEY -> GROQ_API_KEY -> GOOGLE_API_KEY -> Ollama
LLM_PROVIDER=auto
# Optional model override (defaults: gpt-4o-mini, llama-3.3-70b-versatile, gemini-flash-latest, qwen2.5:7b)
LLM_MODEL=

# Paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Free: https://console.groq.com/keys
GROQ_API_KEY=
# Free tier (may use your data for training): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Free, local, no key: https://ollama.com/download, then `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=http://localhost:11434

# Policy-search embeddings: auto | openai | gemini | local
# auto = openai if OPENAI_API_KEY is set, else local (FastEmbed, no key, downloads ~70 MB once).
# Gemini is used only when chosen explicitly. Changing this rebuilds the index automatically.
EMBEDDINGS_PROVIDER=auto

# Where the chat history is stored
CHECKPOINTS_DB_PATH=checkpoints.sqlite
